# Razorpay Payment Link (Dashboard → Payment Links → Create). The buy buttons point here.
# Set the link's "redirect after payment" URL to https://<your-domain>/thank-you
NEXT_PUBLIC_RAZORPAY_LINK=
# Meta Pixel ID (Events Manager). Fires PageView, InitiateCheckout on buy clicks, Purchase on /thank-you.
NEXT_PUBLIC_META_PIXEL_ID=
# Public site URL, used for canonical/OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com
